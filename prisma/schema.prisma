generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Product {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String
  price       Float
  compareAt   Float?
  image       String
  category    String
  stock       Int      @default(0)
  featured    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  orderItems  OrderItem[]
}

model Order {
  id              String      @id @default(cuid())
  orderNumber     String      @unique
  status          String      @default("pending_payment")
  paymentMethod   String      @default("bank_transfer")
  paymentRef      String?
  customerName    String
  customerEmail   String
  customerPhone   String
  shippingAddress String
  city            String
  state           String
  zipCode         String
  country         String      @default("United States")
  subtotal        Float
  shippingCost    Float       @default(0)
  tax             Float       @default(0)
  total           Float
  notes           String?
  adminNotes      String?
  invoiceNumber   String?     @unique
  paidAt          DateTime?
  shippedAt       DateTime?
  deliveredAt     DateTime?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  items           OrderItem[]
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  productId String
  name      String
  price     Float
  quantity  Int
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product   Product @relation(fields: [productId], references: [id])
}

model StoreSettings {
  id              Int    @id @default(1)
  storeName       String @default("TriZen Store")
  tagline         String @default("Premium Tech & Lifestyle")
  email           String @default("support@trizenstore.com")
  phone           String @default("+1 (555) 123-4567")
  address         String @default("123 Innovation Drive, Tech City, TC 10001")
  bankName        String @default("First National Bank")
  accountName     String @default("TriZen Store LLC")
  accountNumber   String @default("****7890")
  routingNumber   String @default("021000021")
  swiftCode       String @default("FNBAUS33")
  iban            String @default("")
  paymentInstructions String @default("Use your order number as the payment reference. Orders ship after payment is confirmed (1-2 business days).")
  shippingFlat    Float  @default(9.99)
  taxRate         Float  @default(0.08)
  currency        String @default("BDT")
}

model Admin {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String   @default("Admin")
  createdAt    DateTime @default(now())
}
